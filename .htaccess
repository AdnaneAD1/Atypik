<IfModule mod_headers.c>
    # Force HTTPS pendant 2 ans, sous-domaines inclus
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Anti-clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Empêche le sniffing MIME
    Header always set X-Content-Type-Options "nosniff"

    # Contrôle les informations de référence envoyées
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restreint l'accès aux APIs du navigateur
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"

    # Isole la page d'origine (anti-XS-Leaks)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Politique de sécurité du contenu — ajustez si le site charge des ressources externes
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.pexels.com https://img.freepik.com https://images.unsplash.com https://res.cloudinary.com https://*.googleusercontent.com https://*.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebase.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://fcm.googleapis.com https://firebaseinstallations.googleapis.com https://accounts.google.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com; media-src 'self' blob: data: https://res.cloudinary.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com"
</IfModule>
